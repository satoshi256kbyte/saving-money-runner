{
  "name": "saving-money-runner",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "format": "prettier --write package.json '*.mjs' 'scripts/**/*.mjs' 'src/**/*.ts' 'cdk/**/*.ts' 'test/**/*.mjs' 'README.md' 'config/**/*.json' '.github/**/*.yml' 'cdk.json'",
    "format:check": "prettier --check package.json '*.mjs' 'scripts/**/*.mjs' 'src/**/*.ts' 'cdk/**/*.ts' 'test/**/*.mjs' 'README.md' 'config/**/*.json' '.github/**/*.yml' 'cdk.json'",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "cdk:synth": "corepack pnpm exec cdk synth --app 'tsx cdk/bin/app.ts' --output cdk.out --quiet",
    "cdk:check": "node scripts/quality/run-cdk-check.mjs",
    "ministack:check": "node scripts/quality/check-ministack.mjs",
    "security:check": "node scripts/quality/check-security-baseline.mjs",
    "github-app:check": "node scripts/github-app/validate-config.mjs config/github-app.example.json",
    "docs:check": "markdownlint-cli2 AGENTS.md README.md 'docs/**/*.md' 'specs/**/*.md'",
    "foundation:check": "node scripts/quality/check-structure.mjs",
    "quality": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm foundation:check && corepack pnpm security:check && corepack pnpm github-app:check && corepack pnpm docs:check && corepack pnpm cdk:check && corepack pnpm ministack:check"
  },
  "dependencies": {
    "aws-cdk-lib": "2.177.0",
    "constructs": "10.4.2"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "aws-cdk": "2.177.0",
    "eslint": "9.17.0",
    "markdownlint-cli2": "0.17.2",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
